{
  "schemaVersion": "punch.preview17-clean-host-e2e-report.v1",
  "artifactKind": "public-format-description",
  "releaseStatus": "PUBLISHED_PRERELEASE",
  "purpose": "Release-gate evidence for a real clean-host Provider-to-Buyer lifecycle.",
  "requiredTopLevelKeys": [
    "schemaVersion",
    "releaseVersion",
    "proofLabel",
    "status",
    "sanitized",
    "credentialsCaptured",
    "executionReceipt",
    "execution",
    "artifact",
    "provider",
    "buyer",
    "cleanup",
    "substitutionGuards"
  ],
  "requiredExecutionReceipt": {
    "schemaVersion": "punch.preview17-clean-host-e2e-execution-receipt.v1",
    "sha256": "sha256:<exact companion receipt bytes>"
  },
  "requiredExecution": {
    "platform": "linux-x64",
    "providerEnvironment": "DISPOSABLE_CLEAN_PROVIDER_VM",
    "buyerEnvironment": "INDEPENDENT_DISPOSABLE_CLEAN_BUYER_VM",
    "control": "CONTROL_COMPATIBLE_RUNTIME",
    "containerEngine": "REAL_DOCKER_ENGINE",
    "registry": "REAL_REGISTRY_DIGEST_PULL",
    "ssh": "REAL_SSH_DATA_PLANE"
  },
  "requiredProviderSteps": [
    "archiveInstall",
    "guidedEntry",
    "hostPreflight",
    "identityConsent",
    "onboardingRequest",
    "waitingForInvite",
    "inviteReady",
    "invitationResume",
    "images",
    "validation",
    "setupReplay",
    "serviceRestart",
    "interactiveCanary",
    "listed"
  ],
  "requiredBuyerSteps": [
    "join",
    "offers",
    "order",
    "provisioning",
    "access",
    "ssh",
    "stop"
  ],
  "requiredCleanupSteps": [
    "sessionClosed",
    "newConnectionRejected",
    "containerRemoved",
    "capacityReleased"
  ],
  "requiredSubstitutionGuards": {
    "fakeDocker": false,
    "fakeFetch": false,
    "inMemoryControl": false,
    "sourceCli": false,
    "mockSsh": false
  },
  "acceptanceRule": "Every required step is PASS on separate clean Provider and Buyer VMs, the exact companion execution-receipt bytes match executionReceipt.sha256, and every correlated receipt invariant passes; a fake or substituted seam rejects release acceptance.",
  "authorityBoundary": "A syntactically valid report and bound sanitized execution receipt are necessary release evidence, not proof by themselves. The release owner must retain the exact archive, runtime binding, report, and execution receipt."
}
