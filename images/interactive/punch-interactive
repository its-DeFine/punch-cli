#!/bin/sh
set -eu

umask 077
test -n "${PUNCH_BUYER_AUTHORIZED_KEY_BASE64:-}" || exit 64
authorized_key="$(printf '%s' "$PUNCH_BUYER_AUTHORIZED_KEY_BASE64" | base64 -d)" || exit 64
unset PUNCH_BUYER_AUTHORIZED_KEY_BASE64

set -- $authorized_key
test "$#" -eq 2 || exit 64
test "$1" = "ssh-ed25519" || exit 64
case "$2" in
  ''|*[!A-Za-z0-9+/=]*) exit 64 ;;
esac
canonical_blob="$(printf '%s' "$2" | base64 -d | base64 | tr -d '\n')" || exit 64
test "$canonical_blob" = "$2" || exit 64
unset canonical_blob

mkdir -m 0700 /workspace/.ssh
printf '%s %s\n' "$1" "$2" > /workspace/.ssh/authorized_keys
chmod 0600 /workspace/.ssh/authorized_keys
unset authorized_key

/usr/bin/dropbearkey -t ed25519 -f /tmp/dropbear_ed25519_host_key >/dev/null 2>&1
exec /usr/sbin/dropbear -F -s -g -w -j -k -I 300 -P /tmp/dropbear.pid \
  -p 127.0.0.1:2222 -r /tmp/dropbear_ed25519_host_key >/dev/null 2>&1
